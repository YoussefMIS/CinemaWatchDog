# Cinema WatchDog configuration
# Copy this file to ".env" (same folder) and fill in what you need.
# Every line is optional. Anything left blank can be set later in the app under Settings.
# Do not share or commit your .env file: it contains your email password.

# ---- Email alerts -----------------------------------------------------------
# The Gmail account that SENDS the alerts. It needs a Gmail App Password
# (https://myaccount.google.com/apppasswords, which requires 2-Step Verification).
# Your normal Gmail password will not work. Spaces in the app password are fine.
# When these are set they override the Settings page, and the password is never saved to disk.
CWD_SMTP_USER=
CWD_SMTP_PASSWORD=

# Mail server. The defaults are for Gmail. For Outlook.com use smtp-mail.outlook.com and port 587.
# Port 465 uses SSL; any other port uses STARTTLS.
CWD_SMTP_HOST=smtp.gmail.com
CWD_SMTP_PORT=465

# Who receives the alerts, comma-separated. This is only a starting value: you can change it in Settings.
CWD_RECIPIENTS=

# ---- Monitoring -------------------------------------------------------------
# Seconds between checks. Minimum 30, default 120. Every check also gets +/-15% random jitter.
# Checking too often may get you rate-limited by the cinema websites.
CWD_INTERVAL_SECONDS=120

# After a showtime is emailed, don't email it again for this many minutes, even if its seats
# disappear and come back (e.g. someone held them in a basket). 0 = no cooldown. Default 60.
# This is only a starting value: you can change it in Settings.
CWD_ALERT_COOLDOWN_MINUTES=60

# ---- Web server -------------------------------------------------------------
# 127.0.0.1 = only this computer can open the app (recommended).
# 0.0.0.0   = phones and other devices on your network can open it too. There is no login, so only use this on a trusted home network.
CWD_HOST=127.0.0.1
CWD_PORT=5000

# Folder for your monitors, settings and alert history. The default is the "data" folder next to app.py.
# CWD_DATA_DIR=D:\CinemaWatchDogData
